# Example environment configuration for image-understanding service
# Copy this file to .env.local and update with your values

# RTSP Camera URL (optional)
# If not set, users can configure it in the UI
VITE_RTSP_URL=rtsp://your-camera-ip:port/stream

# Google Gemini API Key (for development)
GEMINI_API_KEY=your-gemini-api-key

# Google Cloud Project ID (for production with service account)
PROJECT_ID=your-gcp-project-id